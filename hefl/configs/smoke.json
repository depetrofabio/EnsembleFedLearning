{
  "_comment": "Tiny CPU-runnable configuration. Validates every code path end to end in a few minutes. Accuracies are meaningless at this scale - use rotation.json for real numbers.",
  "num_clients": 8,
  "alpha": 100.0,
  "rotation_groups": [0, 1],
  "subsample": 2000,
  "num_clusters": 2,
  "cluster_signal": "act_stats",
  "pca_dim": 4,
  "warmup_fedavg_rounds": 1,
  "warmup_local_epochs": 1,
  "warmup_act_batches": 2,
  "rounds": 2,
  "fraction": 0.5,
  "local_epochs": 1,
  "eval_every": 2,
  "combiners": ["uniform", "beta", "gate", "mlp"],
  "dense_rounds": 1,
  "dense_fraction": 0.5,
  "dense_max_batches": 4,
  "run_fedavg": true,
  "batch_size": 32,
  "output_dir": "./hefl/results/smoke"
}
