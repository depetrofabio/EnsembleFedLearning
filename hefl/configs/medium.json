{
  "_comment": "Laptop-scale run (~30-50 min on Apple MPS). Subsampled CIFAR-10, so absolute accuracies are well below what the full config reaches - use it to check that the ORDERING of the table is sane before committing GPU time.",
  "num_clients": 24,
  "alpha": 0.5,
  "rotation_groups": [0, 1, 2, 3],
  "subsample": 20000,
  "num_clusters": 4,
  "cluster_signal": "act_stats",
  "pca_dim": 16,
  "warmup_fedavg_rounds": 1,
  "warmup_local_epochs": 2,
  "warmup_act_batches": 8,
  "rounds": 25,
  "fraction": 0.5,
  "local_epochs": 1,
  "eval_every": 5,
  "batch_size": 64,
  "lr": 0.02,
  "combiners": ["uniform", "beta", "gate", "mlp"],
  "dense_rounds": 3,
  "dense_fraction": 0.5,
  "dense_max_batches": 8,
  "run_fedavg": true,
  "subset_analysis": false,
  "output_dir": "./hefl/results/medium"
}
