# --- dataset cache (redownloaded automatically by torchvision) ---------------
# cifar-10-python.tar.gz is 163 MB; GitHub rejects any single file over 100 MB,
# so the cache must never be committed.
data_cache/
*.tar.gz

# --- model checkpoints -------------------------------------------------------
# Backbones are ~45 MB each and a run writes K of them. The experimental record
# worth versioning is table.md / results.json / config_used.json, which are kept.
*.pt
*.pth

# --- run outputs -------------------------------------------------------------
# Results are regenerated by scripts/run_sweep.sh. Headline tables are quoted
# inline in docs/REPORT.md, so the repo stays free of stale numbers.
hefl/results/

# --- python ------------------------------------------------------------------
__pycache__/
*.py[cod]
.ipynb_checkpoints/
*.egg-info/
.venv/
venv/

# --- os / editor -------------------------------------------------------------
.DS_Store
.vscode/
.idea/

# --- latex build artefacts ---------------------------------------------------
*.aux
*.log
*.out
*.synctex.gz
